<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title - 微信公众平台 企业号 开放平台 微信支付</title>
    <meta name="keywords" content="微信SDK,微信公众账号,SDK,微信公众平台,企业号,服务号,订阅号,微信支付,开放平台,开发者,第三方工具,说明,文档,AppStore" />
    <meta name="description" content="是目前使用率最高的微信C# SDK，包含完整的公众账号、企业号、开放平台API，帮助第三方开发者轻松实现微信公众账号和企业号开发。" />
    @Styles.Render("~/Content/css")
    <link href="~/Content/darktooltip.min.css" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")
    @Scripts.Render("~/bundles/jquery")
    <script src="~/Content/danktooltip/js/jquery.darktooltip.min.js"></script>
    @RenderSection("HeaderContent", false)
</head>
<body>
    <div class="content">
        <div class="senparc-header">
            <div class="wrapper">
                <div class="header-title"><a href="@Url.Action("Index", "Home")" title="微信SDK（公众平台/企业号/开放平/微信支付/JSSDK/摇一摇周边）">微信SDK（公众平台/企业号/开放平台/微信支付/JSSDK/摇一摇周边）</a></div>
                <div class="navbar-collapse">
                    <ul class="nav-catalog">
                        <li><a href="@Url.Action("Index", "Home")">首页</a></li>
                        <li><a href="@Url.Action("Index", "Menu")">菜单</a></li>
                        <li><a href="@Url.Action("Index", "SimulateTool")">消息模拟</a></li>
                        <li><a href="@Url.Action("JumpToMpOAuth", "OpenOAuth")">开放平台</a></li>
                        <li><a href="@Url.Action("Test", "Cache")">缓存测试</a></li>
                    </ul>
                    <div class="clear"></div>
                </div>
                <div class="clear"></div>
            </div>
        </div>

        @RenderBody()

        <div class="footer">
            <p class="footer-contact">
            </p>
            <p class="footer-icon">&copy; 2006-@DateTime.Now.Year ，版权所有，保留所有权利。</p>
        </div>
        @RenderSection("scripts", required: false)
        <div style="display: none;">
            <script>

                $(function () {
                });

            </script>
        </div>
    </div>
</body>
</html>
