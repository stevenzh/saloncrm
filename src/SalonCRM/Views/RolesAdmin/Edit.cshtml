@model SalonCRM.Models.RoleViewModel
@{
    ViewBag.Title = "编辑角色";
}
<link href="~/Content/zTree/zTreeStyle.css" rel="stylesheet" />
<script src="~/Scripts/zTree/jquery.ztree.core-3.5.min.js"></script>
<script src="~/Scripts/zTree/jquery.ztree.excheck-3.5.min.js"></script>

<div class="header">
    <h1>@ViewBag.Title.</h1>
    <ul class="breadcrumb">
        <li><a href="/home">首页</a> </li>
        <li><a href="/RolesAdmin/Index">角色列表</a></li>
        <li class="active">编辑角色</li>
    </ul>
</div>

<div class="main-content">
    <div class="col-sm-8">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)
            @Html.HiddenFor(model => model.Id)
            @Html.HiddenFor(model => model.HostID)
            @Html.HiddenFor(model => model.MenuItems)

            <div class="form-horizontal">
                <div class="form-group">
                    @Html.LabelFor(model => model.Name, new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Name)
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.IsMajor, new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.CheckBoxFor(model => model.IsMajor, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.IsMajor)
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" value="Save" onsubmit="getselect();" class="btn btn-default" />
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="col-sm-3 col-sm-offset-1">
        <div class="panel panel-default">
            <div class="panel-heading no-collapse">
                功能选择
            </div>
            <ul id="treeDemo" class="ztree"></ul>
        </div>
    </div>
</div>

<script type="text/javascript">
		<!--
		var setting = {
