<p>
    @if (cu.Type == "2")
    {
        Html.ActionLink("编辑", "Edit", new { id = Model.MemberID });
        Html.ViewContext.Writer.Write(" |");
    }
    @Html.ActionLink("返回客户列表", "Index", "MemberAdmin")
</p>
<script type="text/javascript">
    $(function () {
        $('#NextDate').datepicker({
            format: "yyyy-mm-dd",
            language: "zh-CN"
        });
    });
</script>