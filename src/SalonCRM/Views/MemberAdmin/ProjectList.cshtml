@using SalonCRM.Identity;
@{
    CustomPrincipal cUser = User as CustomPrincipal;
}
@Html.DevExpress().GridView(
    settings =>
    {
        settings.Name = "gvProjectList";
        settings.CallbackRouteValues = new
        {
            Controller = "MemberAdmin",
            Action = "ProjectList",
            MemberID = ViewData["MemberID"],
            MemberCardId = ViewData["MemberCardId"]
        };
        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
        settings.KeyFieldName = "MemberProjectId";

        settings.Columns.Add(column =>
        {
            column.FieldName = "ProjectID";
            column.Caption = "项目名称";
            column.EditorProperties().ComboBox(p =>
            {
                p.TextField = "Text";
                p.ValueField = "Value";
                p.ValueType = typeof(int);
                p.DataSource = ViewBag.ProjectDataList;
            });
        });
        settings.Columns.Add(column =>
        {
            column.Caption = "类别";
            column.FieldName = "Type";
            column.ColumnType = MVCxGridViewColumnType.ComboBox;
            var comboBoxProperties = column.PropertiesEdit as ComboBoxProperties;
            comboBoxProperties.Items.Add(new ListEditItem("购买", 0));
            comboBoxProperties.Items.Add(new ListEditItem("赠送", 1));
            comboBoxProperties.Items.Add(new ListEditItem("转卡", 2));
            comboBoxProperties.ValueType = typeof(Int32);
        });
        settings.Columns.Add("UnitPrice", "单价");
        settings.Columns.Add("BookTime", "购买次数");
        settings.Columns.Add("Amount", "购买金额");
        settings.Columns.Add("ActualPrice", "实付金额");
        settings.Columns.Add("UsedTime", "已用次数");
        settings.Columns.Add("LastCount", "可用次数");
        settings.Columns.Add("IsEntity", "即销即耗");
        settings.Columns.Add(column =>
        {
            column.Caption = "是否有效";
            column.FieldName = "IsVaild";
            column.ColumnType = MVCxGridViewColumnType.ComboBox;
            var comboBoxProperties = column.PropertiesEdit as ComboBoxProperties;
            comboBoxProperties.Items.Add(new ListEditItem("有效", 1));
            comboBoxProperties.Items.Add(new ListEditItem("无效", 0));
            comboBoxProperties.ValueType = typeof(Int32);
        });

        if (cUser.IsAdminUser > 0)
        {
            settings.CommandColumn.Visible = true;
            settings.CommandColumn.Width = 120;
            settings.CommandColumn.ShowNewButtonInHeader = true;
            settings.CommandColumn.ShowNewButton = true;
            settings.CommandColumn.ShowEditButton = true;
            settings.CommandColumn.ShowDeleteButton = true;
            settings.SettingsBehavior.ConfirmDelete = true;

            settings.SettingsEditing.AddNewRowRouteValues = new { Controller = "MemberAdmin", Action = "AddNewProjectPartial", MemberID = ViewData["MemberID"], MemberCardId = ViewData["MemberCardId"] };
            settings.SettingsEditing.UpdateRowRouteValues = new { Controller = "MemberAdmin", Action = "UpdateProjectPartial", MemberID = ViewData["MemberID"], MemberCardId = ViewData["MemberCardId"] };
            settings.SettingsEditing.DeleteRowRouteValues = new { Controller = "MemberAdmin", Action = "DeleteProjectPartial", MemberID = ViewData["MemberID"], MemberCardId = ViewData["MemberCardId"] };
        }

        settings.HtmlRowPrepared = (sender, e) =>
        {
            try
            {
                if (e.RowType != GridViewRowType.Data) return;
                string value = e.GetValue("IsVaild").ToString();
                //  0 失效 1 有效
                if (value == "0")
                    e.Row.BackColor = System.Drawing.Color.Moccasin;
            }
            catch { }
        };

        if (ViewData["EditError"] != null)
        {
            settings.SetFooterRowTemplateContent(c =>
            {
                Html.ViewContext.Writer.Write(ViewData["EditError"]);
            });
        }
        settings.BeforeGetCallbackResult = (s, e) =>
        {
            if (ViewData["EditError"] != null)
            {
                MVCxGridView gridView = (MVCxGridView)s;
                gridView.Settings.ShowFooter = true;
            }
        };

    }).Bind(Model).GetHtml()