@model SalonCRM.Models.MemberViewModel
@{
    ViewBag.Title = "编辑客户";
}
@section AdditionalResources {
    @Scripts.Render("~/bundles/jqueryval")
}
<div class="header">
    <h1>编辑客户信息.</h1>
    <ul class="breadcrumb">
        <li><a href="/home">首页</a> </li>
        <li><a href="/memberadmin/Index">客户列表</a></li>
        <li class="active">编辑客户</li>
    </ul>
</div>
<div class="main-content">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="form-horizontal">
            @Html.HiddenFor(m => m.MemberID)
            @Html.ValidationSummary("", new { @class = "text-error" })
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Name, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Passwd, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.PasswordFor(m => m.Passwd, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.CardNo, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.TextBoxFor(m => m.CardNo, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.JoinDate, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.EditorFor(m => m.JoinDate, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.JoinBranch, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.DropDownListFor(m => m.JoinBranch, (SelectList)ViewBag.OrganId, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Source, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.DropDownListFor(m => m.Source, (SelectList)ViewBag.MemberSource, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Type, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.DropDownListFor(m => m.Type, (SelectList)ViewBag.MemberType, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.SalesmanId, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.DropDownListFor(m => m.SalesmanId, (SelectList)ViewBag.Salesman, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.BeauticianId, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.DropDownListFor(m => m.BeauticianId, (SelectList)ViewBag.Beautician, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                </div>
            </div>

            <h4>基本信息.</h4>
            <hr />
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Sex, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.DropDownListFor(m => m.Sex, (SelectList)ViewBag.Genders, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Birthday, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.EditorFor(m => m.Birthday, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.MaritalStatus, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.DropDownListFor(m => m.MaritalStatus, (SelectList)ViewBag.MaritalStatus, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Conjugal, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.TextBoxFor(m => m.Conjugal, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.WeddingDay, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.EditorFor(m => m.WeddingDay, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Vocation, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.DropDownListFor(m => m.Vocation, (SelectList)ViewBag.MemberVocation, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Position, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.TextBoxFor(m => m.Position, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Company, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.TextBoxFor(m => m.Company, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>
            <h4>联系信息.</h4>
            <hr />
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.MobileNumber, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.TextBoxFor(m => m.MobileNumber, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.WebChat, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.TextBoxFor(m => m.WebChat, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.TencentQQ, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.TextBoxFor(m => m.TencentQQ, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Email, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Address, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.TextAreaFor(m => m.Address, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.CompanyAddress, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.TextAreaFor(m => m.CompanyAddress, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>

            <h4>核心信息.</h4>
            <hr />
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.PersonalityE, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.ListBoxFor(m => m.PersonalityE, (SelectList)ViewBag.Personalitys, new { @class = "form-control", @multiple = "multiple" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.ConsumptionHabitE, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.ListBoxFor(m => m.ConsumptionHabitE, (SelectList)ViewBag.ConsumptionHabits, new { @class = "form-control", @multiple = "multiple" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.SkinConditionE, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.ListBoxFor(m => m.SkinConditionE, (SelectList)ViewBag.SkinConditions, new { @class = "form-control", @multiple = "multiple" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.BodyDemandE, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.ListBoxFor(m => m.BodyDemandE, (SelectList)ViewBag.BodyDemands, new { @class = "form-control", @multiple = "multiple" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.FacialDemandE, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.ListBoxFor(m => m.FacialDemandE, (SelectList)ViewBag.FacialDemands, new { @class = "form-control", @multiple = "multiple" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.CustomerDemandE, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.ListBoxFor(m => m.CustomerDemandE, (SelectList)ViewBag.CustomerDemands, new { @class = "form-control", @multiple = "multiple" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.SkinTypeE, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.ListBoxFor(m => m.SkinTypeE, (SelectList)ViewBag.SkinTypes, new { @class = "form-control", @multiple = "multiple" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" class="btn btn-default" value="保存" />
                </div>
            </div>
        </div>
    }
    <div>
        @Html.ActionLink("客户列表", "Index", "MemberAdmin")
    </div>
</div>

<script type="text/javascript">
    $(function () {
        $('#Birthday').datepicker({
            format: "yyyy-mm-dd",
            language: "zh-CN"
        });
        $('#JoinDate').datepicker({
            format: "yyyy-mm-dd",
            language: "zh-CN"
        });
        $('#WeddingDay').datepicker({
            format: "yyyy-mm-dd",
            language: "zh-CN"
        });
    });

    $('#PersonalityE').multiselect({ nonSelectedText: "请选择" });
    $('#SkinTypeE').multiselect({ nonSelectedText: "请选择" });
    $('#SkinConditionE').multiselect({ nonSelectedText: "请选择" });
    $('#BodyDemandE').multiselect({ nonSelectedText: "请选择" });
    $('#FacialDemandE').multiselect({ nonSelectedText: "请选择" });
    $('#CustomerDemandE').multiselect({ nonSelectedText: "请选择" });
    $('#ConsumptionHabitE').multiselect({ nonSelectedText: "请选择" });
</script>
