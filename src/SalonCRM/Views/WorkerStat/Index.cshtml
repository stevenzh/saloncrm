@{
    ViewBag.Title = "员工排名";
    // 门店用户登录
    CustomPrincipal cu = (CustomPrincipal)User;
}
@model SalonCRM.Models.WorkerQModel
@using SalonCRM.Identity
@section AdditionalResources {
    @Html.DevExpress().GetStyleSheets(
    new StyleSheet { ExtensionSuite = ExtensionSuite.NavigationAndLayout },
    new StyleSheet { ExtensionSuite = ExtensionSuite.Editors },
    new StyleSheet { ExtensionSuite = ExtensionSuite.HtmlEditor },
    new StyleSheet { ExtensionSuite = ExtensionSuite.GridView },
    new StyleSheet { ExtensionSuite = ExtensionSuite.TreeList }
)
    @Html.DevExpress().GetScripts(
    new Script { ExtensionSuite = ExtensionSuite.NavigationAndLayout },
    new Script { ExtensionSuite = ExtensionSuite.HtmlEditor },
    new Script { ExtensionSuite = ExtensionSuite.GridView },
    new Script { ExtensionSuite = ExtensionSuite.Editors },
    new Script { ExtensionSuite = ExtensionSuite.TreeList }
)
}
<div class="header">
    <h1>@ViewBag.Title</h1>
</div>
<div class="main-content">
    @using (Html.BeginForm("Index", "WorkerStat", FormMethod.Post))
    {
        <table class="">
            <tr style="height: 45px;">
                <td style="padding-right: 4px">门店</td>
                <td style="padding-right: 4px">
                    @if (cu.Type == "2")
                    {
                        @Html.DevExpress().ComboBoxFor(m => m.BranchID,
                          settings =>
                          {
                              settings.Name = "BranchId";
                              settings.Width = 180;
                              settings.Properties.TextField = "Text";
                              settings.Properties.ValueField = "Value";
                              settings.Properties.ValueType = typeof(Int32);
                          }).BindList(ViewBag.OrganId).GetHtml();
                    }
                    else
                    {
                        @Html.DevExpress().TextBox(settings =>
                          {
                              settings.Name = "BranchName";
                              settings.ReadOnly = true;
                              settings.Text = SalonCRM.Web.GlobalContext.Current.UserDepartment.Name;
                          }).GetHtml()
                        @Html.HiddenFor(m => m.BranchID);
                    }
                </td>
                <td style="padding-right: 4px">员工类型</td>
                <td style="padding-right: 4px">
                    @Html.DevExpress().ComboBoxFor(m => m.WorkerType,
                     settings =>
                     {
                         settings.Name = "WorkerType";
                         settings.Width = 180;
                         settings.Properties.Items.Add(new ListEditItem("请选择", ""));
                         settings.Properties.Items.Add(new ListEditItem("美容顾问", "3"));
                         settings.Properties.Items.Add(new ListEditItem("美容师", "1"));
                         settings.Properties.ValueType = typeof(string);
                     }).GetHtml()
                </td>
                <td style="padding-right: 4px">名称</td>
                <td style="padding-right: 4px">
                    @Html.DevExpress().TextBoxFor(m => m.WorkerName).GetHtml()
                </td>
                <td style="padding-right: 4px">起始日期</td>
                <td style="padding-right: 4px">
                    @Html.DevExpress().DateEditFor(m => m.StartDate, settings =>
               {
                   settings.Width = 100;
               }).GetHtml()
                </td>
                <td style="padding-right: 4px">结束日期</td>
                <td style="padding-right: 4px">
                    @Html.DevExpress().DateEditFor(m => m.EndDate, settings =>
               {
                   settings.Width = 100;
               }).GetHtml()
                </td>
            </tr>
            <tr style="height: 45px;">
                <td style="padding-right: 4px">客户类型</td>
                <td style="padding-right: 4px">
                    @Html.DevExpress().ComboBoxFor(m => m.MemberType,
                     settings =>
                     {
                         settings.Name = "MemberType";
                         settings.Width = 180;
                         settings.Properties.Items.Add(new ListEditItem("请选择", ""));
                         settings.Properties.Items.Add(new ListEditItem("正式客户", "L01"));
                         settings.Properties.Items.Add(new ListEditItem("体验客户", "L02"));
                         settings.Properties.ValueType = typeof(string);
                     }).GetHtml()
                </td>
                <td style="padding-right: 4px">新老客户</td>
                <td style="padding-right: 4px">
                    @Html.DevExpress().ComboBoxFor(m => m.MemberNewType,
                     settings =>
                     {
                         settings.Name = "MemberNewType";
                         settings.Width = 180;
                         settings.Properties.Items.Add(new ListEditItem("请选择", ""));
                         settings.Properties.Items.Add(new ListEditItem("新客户", "1"));
                         settings.Properties.Items.Add(new ListEditItem("老客户", "0"));
                         settings.Properties.ValueType = typeof(string);
                     }).GetHtml()
                </td>
                <td style="padding-right: 4px">排序</td>
                <td style="padding-right: 4px">
                    @Html.DevExpress().ComboBoxFor(m => m.Sort,
                     settings =>
                     {
                         settings.Name = "Sort";
                         settings.Width = 180;
                         settings.Properties.Items.Add(new ListEditItem("业绩", "0"));
                         settings.Properties.Items.Add(new ListEditItem("消耗", "1"));
                         settings.Properties.Items.Add(new ListEditItem("实操", "2"));
                         settings.Properties.Items.Add(new ListEditItem("即消即耗", "3"));
                         settings.Properties.Items.Add(new ListEditItem("服务人次", "4"));
                         settings.Properties.Items.Add(new ListEditItem("服务项目量", "5"));
                         settings.Properties.ValueType = typeof(string);
                     }).GetHtml()
                </td>
                <td style="padding-right: 4px"></td>
                <td style="padding-right: 4px">
                    <input type="submit" class="btn btn-default" value="搜索" />
                    <dx:ASPxButton ID="btnXlsExport" runat="server" Text="导出Excel" UseSubmitBehavior="False" OnClick="btnXlsExport_Click" />
                </td>
            </tr>
        </table>
    }
    <br />
    @Html.Partial("PageList", Model.WorkerList)
</div>
