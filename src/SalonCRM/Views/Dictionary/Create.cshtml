@model SalonCRM.Models.DictionaryViewModel
<div class="header">
    <h1>创建 @ViewBag.Title.</h1>
    <ul class="breadcrumb">
        <li><a href="/home">首页</a> </li>
        <li>@Html.ActionLink("返回列表", "Index", new { Category = (String)ViewBag.Category })</li>
        <li class="active">创建 @ViewBag.Title</li>
    </ul>
</div>

<div class="main-content">
    @using (Html.BeginForm("Create", "Dictionary", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(t => t.Category)
        @Html.ValidationSummary("", new { @class = "text-error" })
        if (ViewBag.Category != null)
        {
            <div class="form-group">
                @Html.LabelFor(model => model.Identifier, new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.TextBoxFor(m => m.Identifier, new { @class = "form-control", @readonly = "readonly" })
                </div>
            </div>
        }
        else
        {
            <div class="form-group">
                @Html.LabelFor(m => m.Identifier, new { @class = "col-md-2 control-label" })
                <div class="col-md-10">
                    @Html.DropDownListFor(m => m.Identifier, (SelectList)ViewBag.DictionaryType, new { @class = "form-control" })
                </div>
            </div>
        }
        <div class="form-group">
            @Html.LabelFor(m => m.KeyValue, new { @class = "col-md-2 control-label" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.KeyValue, new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.Contents, new { @class = "col-md-2 control-label" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.Contents, new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.Remark, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextAreaFor(m => m.Remark, new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.SortOrder, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.SortOrder, new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.IsDefault, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.CheckBoxFor(m => m.IsDefault, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.IsDefault)
            </div>
        </div>
        if (ViewBag.Category == "MemberLevel")
        {
            <div class="form-group">
                <label class="control-label col-md-2">年消费区间</label>
                <div class="col-md-10">
                    <div class="form-inline">
                        @Html.TextBoxFor(m => m.MinAmount, new { @class = "form-control" })
                        -
                        @Html.TextBoxFor(m => m.MaxAmount, new { @class = "form-control" })
                    </div>

                </div>
            </div>
        }
        if (ViewBag.Category == "MemberStatus")
        {
            <div class="form-group">
                <label class="control-label col-md-2">月份区间</label>
                <div class="col-md-10">
                    <div class="form-inline">
                        @Html.TextBoxFor(m => m.FMonth, new { @class = "form-control" })
                        -
                        @Html.TextBoxFor(m => m.SMonth, new { @class = "form-control" })

                        @Html.DropDownListFor(m => m.MonthSet, (SelectList)ViewBag.CategorySet, new { @class = "form-control" })
                    </div>
                </div>
            </div>
        }
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" class="btn btn-default" value="创建" />
            </div>
        </div>
    }
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
