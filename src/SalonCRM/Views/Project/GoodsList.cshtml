@Html.DevExpress().GridView(
    settings =>
    {
        settings.Name = "gvSplit";
        settings.CallbackRouteValues = new { Controller = "Project", Action = "GoodsList", ProjectID = ViewData["ProjectID"] };
        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
        settings.KeyFieldName = "ProjectGoodsID";

        settings.Columns.Add(column =>
        {
            column.FieldName = "Goods.Category";
            column.Caption = "类型";
            column.EditorProperties().ComboBox(p =>
            {
                p.TextField = "Text";
                p.ValueField = "Value";
                p.DataSource = ViewBag.CategoryList;
                p.ClientSideEvents.SelectedIndexChanged = "OnSelectedCountryChanged";
            });
        });
        settings.Columns.Add(column =>
        {
            column.Caption = "货品名称";
            column.FieldName = "Goods.Name";
            column.EditorProperties().ComboBox(p =>
            {
                p.CallbackRouteValues = new { Controller = "Project", Action = "GetGoods", TextField = "Name" };
                p.TextField = "Name";
                p.ValueField = "GoodsID";
                p.LoadDropDownOnDemand = true;
                p.ClientSideEvents.BeginCallback = "CityComboBox_BeginCallback";
            });
        });
        settings.Columns.Add("Quantity", "数量");

        settings.Settings.ShowHeaderFilterButton = false;
        settings.Settings.ShowFilterRow = false;
        settings.Settings.ShowFilterRowMenu = false;
        settings.SettingsPager.PageSize = 20;


        settings.CommandColumn.Visible = true;
        settings.CommandColumn.Width = 120;
        settings.CommandColumn.ShowNewButtonInHeader = true;
        settings.CommandColumn.ShowNewButton = true;
        settings.CommandColumn.ShowDeleteButton = true;
        settings.CommandColumn.ShowEditButton = true;

        settings.SettingsEditing.AddNewRowRouteValues = new { Controller = "Project", Action = "AddNewSplitPartial", ProjectID = ViewData["ProjectID"] };
        settings.SettingsEditing.UpdateRowRouteValues = new { Controller = "Project", Action = "UpdateSplitPartial", ProjectID = ViewData["ProjectID"] };
        settings.SettingsEditing.DeleteRowRouteValues = new { Controller = "Project", Action = "DeleteSplitPartial", ProjectID = ViewData["ProjectID"] };

    }).Bind(Model).GetHtml()

