@using SalonCRM.Models
@{
    ViewBag.Title = "客户统计";
    var sl = ViewBag.StatusList as List<KeyNameCountModel>;
    var ll = ViewBag.LevelList as List<KeyNameCountModel>;
}
@section AdditionalResources {
    <style>
        .label { font-size: 90%; }
    </style>
}

<div class="header">
    <h1>@ViewBag.Title.</h1>
    <ul class="breadcrumb">
        <li class="active">@ViewBag.Title</li>
    </ul>
</div>


<div class="main-content">
    <div class="row">
        <div class="col-md-4">
            <ul class="cards list-group" style="margin-top: 1em;">
                <li class="list-group-item list-group-item-heading">按照状态统计</li>
                @foreach (var item in sl)
                {
                    <li class="list-group-item"><a href="/MemberAdmin/Index?Status=@item.Key">@item.Name</a><span class="pull-right label label-success">@item.Count</span></li>
                }
            </ul>
        </div>
        <div class="col-md-8">
            <div id="chart" style="width:100%; height:250px;"></div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <ul class="cards list-group" style="margin-top: 1em;">
                <li class="list-group-item list-group-item-heading">按照新旧统计</li>
                <li class="list-group-item "><a href="/MemberAdmin/Index?IsNew=0">老会员</a><span class="pull-right label label-success">@ViewBag.OldMemberCount</span></li>
                <li class="list-group-item "><a href="/MemberAdmin/Index?IsNew=1">新增会员</a><span class="pull-right label label-success">@ViewBag.NewMemberCount</span></li>
            </ul>
        </div>
        <div class="col-md-8">
            <div id="chart" style="width:100%; height:250px;"></div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <ul class="cards list-group" style="margin-top: 1em;">
                <li class="list-group-item list-group-item-heading">按照等级统计</li>
                @foreach (var item in ll)
                {
                    <li class="list-group-item"><a href="/MemberAdmin/Index?Level=@item.Key">@item.Name</a><span class="pull-right label label-success">@item.Count</span></li>
                }
            </ul>
        </div>

        <div class="col-md-8">
            <div id="chart1" style="width:100%; height:250px;"></div>

        </div>
    </div>
</div>
@section Scripts {
    <!-- ECharts单文件引入 -->
    <script src="http://cdn.bootcss.com/echarts/3.4.0/echarts.min.js"></script>
    <script type="text/javascript">

        // 基于准备好的dom，初始化echarts图表
        var myChart = echarts.init(document.getElementById('chart'));

        var option = {
            tooltip: {
                trigger: 'item',
                formatter: "{a} <br/>{b}: {c} ({d}%)"
            },
            legend: {
                orient: 'vertical',
                x: 'left',
                data: [ @foreach (var item in sl) { @Html.Raw("\'" + item.Name+"\',") }]
            },
            series: [
                {
                    name: '客户人数',
                    type: 'pie',
                    radius: ['50%', '70%'],
                    avoidLabelOverlap: false,
                    label: {
                        normal: {
                            show: false,
                            position: 'center'
                        },
                        emphasis: {
                            show: true,
                            textStyle: {
                                fontSize: '20',
                                fontWeight: 'bold'
                            }
                        }
                    },
                    labelLine: {
                        normal: {
                            show: false
                        }
                    },
                    data: [
                        @foreach (var item in sl) { @Html.Raw("{value:"+item.Count+",name:'" + item.Name+"'},") }
                    ]
                }
            ]
        };


        // 为echarts对象加载数据
        myChart.setOption(option);

    </script>

<script type="text/javascript">

        // 基于准备好的dom，初始化echarts图表
        var myChart1 = echarts.init(document.getElementById('chart1'));

        var option1 = {
            tooltip: {
                trigger: 'item',
                formatter: "{a} <br/>{b}: {c} ({d}%)"
            },
            legend: {
                orient: 'vertical',
                x: 'left',
                data: [ @foreach (var item in ll) { @Html.Raw("\'" + item.Name+"\',") }]
            },
            series: [
                {
                    name: '客户人数',
                    type: 'pie',
                    radius: ['50%', '70%'],
                    avoidLabelOverlap: false,
                    label: {
                        normal: {
                            show: false,
                            position: 'center'
                        },
                        emphasis: {
                            show: true,
                            textStyle: {
                                fontSize: '20',
                                fontWeight: 'bold'
                            }
                        }
                    },
                    labelLine: {
                        normal: {
                            show: false
                        }
                    },
                    data: [
                        @foreach (var item in ll) { @Html.Raw("{value:"+item.Count+",name:'" + item.Name+"'},") }
                    ]
                }
            ]
        };


        // 为echarts对象加载数据
        myChart1.setOption(option1);

</script>
}