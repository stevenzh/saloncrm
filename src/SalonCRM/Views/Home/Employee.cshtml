@{
    ViewBag.Title = "员工统计";
}

<div class="header">
    <h1>@ViewBag.Title.</h1>
    <ul class="breadcrumb">
        <li class="active">@ViewBag.Title</li>
    </ul>
</div>


<div class="main-content">
    <div class="row">
        <div class="col-md-6">
            <ul class="cards list-group" style="margin-top: 1em;">
                <li class="list-group-item"><a href="/Branch/Index">门店总数</a><span class="pull-right label label-success">@ViewBag.BranchCount</span></li>
                <li class="list-group-item"><a href="/Worker/Index?Type=3">美容顾问总数</a><span class="pull-right label label-success">@ViewBag.SalesCount</span></li>
                <li class="list-group-item"><a href="/Worker/Index?Type=1">美容师总数</a><span class="pull-right label label-success">@ViewBag.BeauticianCount</span></li>
            </ul>
        </div>
        <div class="col-md-6">
            <div id="chart" style="width:100%; height:250px;"></div>
        </div>
    </div>

</div>
@section Scripts {
    <!-- ECharts单文件引入 -->
    <script src="http://cdn.bootcss.com/echarts/3.4.0/echarts.min.js"></script>
    <script type="text/javascript">

        // 基于准备好的dom，初始化echarts图表
        var myChart = echarts.init(document.getElementById('chart'));

        var option = {
            tooltip: {
                trigger: 'item',
                formatter: "{a} <br/>{b}: {c} ({d}%)"
            },
            legend: {
                orient: 'vertical',
                x: 'left',
                data: [ '美容顾问', '美容师']
            },
            series: [
                {
                    name: '员工占比',
                    type: 'pie',
                    radius: ['50%', '70%'],
                    avoidLabelOverlap: false,
                    label: {
                        normal: {
                            show: false,
                            position: 'center'
                        },
                        emphasis: {
                            show: true,
                            textStyle: {
                                fontSize: '20',
                                fontWeight: 'bold'
                            }
                        }
                    },
                    labelLine: {
                        normal: {
                            show: false
                        }
                    },
                    data: [
                        { value: @ViewBag.SalesCount, name: '美容顾问' },
                        { value: @ViewBag.BeauticianCount, name: '美容师' }
                    ]
                }
            ]
        };


        // 为echarts对象加载数据
        myChart.setOption(option);

    </script>
}