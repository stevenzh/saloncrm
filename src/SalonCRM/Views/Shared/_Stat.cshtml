<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - 管理经营数据分析系统</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link href="~/Content/page.pagination.css" rel="stylesheet" />
    <link href="~/Content/premium/premium.css" rel="stylesheet" />
    <link href="~/Content/premium/theme.css" rel="stylesheet" />
    <link href="~/Content/font-awesome/css/font-awesome.css" rel="stylesheet" />
    <style type="text/css">
        .navbar-default .navbar-brand, .navbar-default .navbar-brand:hover { color: #fff; }
    </style>
    @Scripts.Render("~/bundles/jquery")
    <script src="~/Content/jQuery-Knob/js/jquery.knob.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(function () {
            $(".knob").knob();
        });
    </script>
</head>
<body class=" theme-blue">
    <div class="navbar navbar-default" role="navigation">
        <div class="navbar-header">
            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
            <a class="" href="/Home/Index"><span class="navbar-brand"><span class="fa fa-paper-plane"></span> 管理经营数据分析系统</span></a>
        </div>
        <div class="navbar-collapse collapse">
            @Html.Partial("_LoginPartial")
        </div>
    </div>
    <div class="sidebar-nav">
        <ul>
            <li><a href="/Home/Index" class="nav-header"><i class="fa fa-fw fa-home"></i> 桌面</a></li>
            @if (Request.IsAuthenticated && (User.IsInRole("管理员") || User.IsInRole("店长")))
            {
                <li>
                    <a href="#" id="accounts-nav" data-target=".accounts-menu" class="nav-header collapsed" data-toggle="collapse">
                        <i class="fa fa-fw fa-briefcase"></i> 客户管理 <i class="fa fa-collapse"></i>
                    </a>
                </li>
                <li>
                    <ul id="accounts-menu" class="accounts-menu nav nav-list collapse">
                        <li><a href="/MemberAdmin/Index"><span class="fa fa-caret-right"></span> 会员管理</a></li>
                        <li><a href="#"><span class="fa fa-caret-right"></span> 转卡维护</a></li>
                        <li><a href="#"><span class="fa fa-caret-right"></span> 危机管理</a></li>
                    </ul>
                </li>
                <li>
                    <a href="#" id="finance-nav" data-target=".finance-menu" class="nav-header collapsed" data-toggle="collapse">
                        <i class="fa fa-fw fa-bar-chart-o"></i> 财务统计 <i class="fa fa-collapse"></i>
                    </a>
                </li>
                <li>
                    <ul id="finance-menu" class="finance-menu nav nav-list collapse">
                        <li><a href="/Stat/DailyStat.aspx"><span class="fa fa-caret-right"></span>日报表</a></li>
                        <li><a href="#"><span class="fa fa-caret-right"></span>日报表调整</a></li>
                        <li><a href="/Content/Reporting/Financial_Project_List.aspx"><span class="fa fa-caret-right"></span>项目销售、消耗一览表</a></li>
                        <li><a href="/Content/Reporting/Financial_Receivables.aspx"><span class="fa fa-caret-right"></span>应收款一览表</a></li>
                        <li><a href="/Content/Reporting/Financial_Debts.aspx"><span class="fa fa-caret-right"></span>欠款一览表</a></li>
                        <li><a href="/Content/Reporting/Financial_Beautician_ranking.aspx"><span class="fa fa-caret-right"></span>美容师排名</a></li>
                    </ul>
                </li>
                <li>
                    <a href="#" data-target=".report-menu" class="nav-header collapsed" data-toggle="collapse">
                        <i class="fa fa-fw fa-bar-chart-o"></i> 客户统计 <i class="fa fa-collapse"></i>
                    </a>
                </li>
                <li>
                    <ul id="report-menu" class="report-menu nav nav-list collapse">
                        <li><a href="/Content/Reporting/Customer_statistics.aspx"><span class="fa fa-caret-right"></span>客户统计</a></li>
                        <li><a href="/Content/Reporting/Customer_transaction.aspx"><span class="fa fa-caret-right"></span>预约到店成交统计</a></li>
                        <li><a href="/Content/Reporting/Customer_consumption.aspx"><span class="fa fa-caret-right"></span>客户消费/消耗统计</a></li>
                        <li><a href="/Content/Reporting/Customer_consumption_details.aspx"><span class="fa fa-caret-right"></span>客户消费明细</a></li>
                        <li><a href="/Content/Reporting/Customer_attendance.aspx"><span class="fa fa-caret-right"></span>接待量统计/客户考勤</a></li>
                        <li><a href="/Content/Reporting/Customer_attendance_daily.aspx?year=2014&month=9"><span class="fa fa-caret-right"></span>客户考勤日报</a></li>
                        <li><a href="/Report/GiveStatistics"><span class="fa fa-caret-right"></span>客户赠送统计</a></li>
                    </ul>
                </li>
                <li>
                    <a href="#" data-target=".business-menu" class="nav-header collapsed" data-toggle="collapse">
                        <i class="fa fa-fw fa-bar-chart-o"></i> 经营分析 <i class="fa fa-collapse"></i>
                    </a>
                </li>
                <li>
                    <ul id="business-menu" class="business-menu nav nav-list collapse">
                        <li><a href="#"><span class="fa fa-caret-right"></span> 年度数据对比</a></li>
                        <li><a href="/Content/Reporting/Manage_Performance.aspx"><span class="fa fa-caret-right"></span> 年度业绩汇总表</a></li>
                        <li><a href="/Content/Reporting/Manage_Sale_Consumption.aspx"><span class="fa fa-caret-right"></span> 综合统计分析</a></li>
                        <li><a href="/Stat/BranchRanking.aspx"><span class="fa fa-caret-right"></span>门店业绩排名</a></li>
                        <li><a href="#"><span class="fa fa-caret-right"></span> 门店动态监测</a></li>
                    </ul>
                </li>
                <li>
                    <a href="#" data-target=".dashboard-menu" class="nav-header collapsed" data-toggle="collapse">
                        <i class="fa fa-fw fa-cogs"></i> 系统设置<i class="fa fa-collapse"></i>
                    </a>
                </li>
                <li>
                    <ul id="dashboard-menu" class="dashboard-menu nav nav-list collapse">
                        <li><a href="#"><span class="fa fa-caret-right"></span> 基础数据</a></li>
                        <li><a href="/Objective/Index"><span class="fa fa-caret-right"></span> 业绩指标设置</a></li>
                        <li><a href="/UsersAdmin/Index"><span class="fa fa-caret-right"></span> 帐号管理</a></li>
                        <li><a href="/Worker/Index"><span class="fa fa-caret-right"></span> 员工管理</a></li>

                        @if (User.IsInRole("管理员"))
                        {
                            <li><a href="#"><span class="fa fa-caret-right"></span> 卡管理</a></li>
                            <li><a href="/Project/Index"><span class="fa fa-caret-right"></span> 项目管理</a></li>
                            <li><a href="/Branch/Index"><span class="fa fa-caret-right"></span> 门店管理</a></li>
                            <li><a href="/Client/Index"><span class="fa fa-caret-right"></span> 终端管理</a></li>
                        }

                        <li><a href="#"><span class="fa fa-caret-right"></span> 知识/短信库</a></li>
                        <li><a href="#"><span class="fa fa-caret-right"></span> 数据导入导出</a></li>
                        <li><a href="#"><span class="fa fa-caret-right"></span> 操作日志</a></li>
                        <li><a href="/Book/Index"><span class="fa fa-caret-right"></span> 经营流水</a></li>

                        @if (User.IsInRole("超级管理员"))
                        {
                            <li><a href="/Dictionary/Index?category=MemberLevel"><span class="fa fa-caret-right"></span> 客户分类设置</a></li>
                            <li><a href="/Dictionary/Index"><span class="fa fa-caret-right"></span> 词典</a></li>
                            <li><a href="/RolesAdmin/Index"><span class="fa fa-caret-right"></span> 权限设置</a></li>
                            <li><a href="/Host/Index"><span class="fa fa-caret-right"></span> 商家管理</a></li>
                        }
                    </ul>
                </li>
            }
            <li><a href="/Home/About" class="nav-header"><i class="fa fa-fw fa-question-circle"></i> 关于我们</a></li>
            <li><a href="/Home/Contact" class="nav-header"><i class="fa fa-fw fa-question-circle"></i> 联系我们</a></li>
        </ul>
    </div>
    <div class="content">
        @RenderBody()
        <footer>
            <p>&copy; @DateTime.Now.Year - My ASP.NET Application</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    <script type="text/javascript">
        $(function () {
            var match = document.cookie.match(new RegExp('color=([^;]+)'));
            if (match) var color = match[1];
            if (color) {
                $('body').removeClass(function (index, css) {
                    return (css.match(/\btheme-\S+/g) || []).join(' ')
                })
                $('body').addClass('theme-' + color);
            }

            //$('[data-popover="true"]').popover({ html: true });
        });

        function stripTrailingSlash(str) {
            if (str.substr(-1) == '/') {
                return str.substr(0, str.length - 1);
            }
            return str;
        }

        var url = window.location.pathname;
        if (url == '/Dictionary/Index')
            url = window.location.pathname + window.location.search;
        var activePage = stripTrailingSlash(url);

        $('.sidebar-nav li a').each(function () {
            var currentPage = stripTrailingSlash($(this).attr('href'));
            if (activePage == currentPage) {
                $(this).parent().parent().addClass('in');
            }
        });
    </script>
    <script type="text/javascript">
        $(function () {
            var uls = $('.sidebar-nav > ul > *').clone();
            uls.addClass('visible-xs');
            $('#main-menu').append(uls.clone());
        });
    </script>
</body>
</html>
