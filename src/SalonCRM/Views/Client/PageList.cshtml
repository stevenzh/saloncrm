@Html.DevExpress().GridView(
    settings =>
    {
        settings.Name = "gvSorting";
        settings.CallbackRouteValues = new { Controller = "Client", Action = "PageList",  };
        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);

        settings.Columns.Add("BranchName", "部门");
        settings.Columns.Add("UserName", "登陆用户");
        settings.Columns.Add("MobileGUID", "终端ID");
        settings.Columns.Add("MobileModel", "终端说明");
        settings.Columns.Add("IsVaildValue", "是否有效");
        settings.Columns.Add("LastSignIn", "最后登陆时间");
        
        settings.Columns.Add(column =>
        {
            //column.Caption = "管理";
            //column.Width = 90;
            column.SetDataItemTemplateContent(delegate (GridViewDataItemTemplateContainer c)
            {
                ViewContext.Writer.Write(Html.ActionLink("编辑", "Edit", "Client", new
                {
                    Id = DataBinder.Eval(c.DataItem, "ClientID")
                }, new { target = "_self" }).ToHtmlString());
            });
        });

        settings.Settings.ShowHeaderFilterButton = true;
        settings.Settings.ShowFilterRow = true;
        settings.SettingsPopup.HeaderFilter.Height = 200;

    }).Bind(Model).GetHtml()

