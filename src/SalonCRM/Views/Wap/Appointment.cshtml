@model SalonCRM.Models.Appointment
@{
    Layout = "~/Views/Shared/_WapLayout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title">预约详情</h3>
            </div>
            <!-- /.box-header -->
            <div class="box-body">
                <strong><i class="fa fa-book margin-r-5"></i> 预约房间</strong>
                <p class="text-muted">@Html.DisplayFor(model => model.BookRooms)</p>
                <hr>
                <strong><i class="fa fa-map-marker margin-r-5"></i> 预约美容师</strong>
                <p class="text-muted">@Html.DisplayFor(model => model.Wokers)</p>
                <hr>
                <strong><i class="fa fa-pencil margin-r-5"></i> 门店</strong>
                <p class="text-muted">@Html.DisplayFor(model => model.BranchId)</p>
                <hr>
                <strong><i class="fa fa-file-text-o margin-r-5"></i> No操作时间tes</strong>
                <p>@Html.DisplayFor(model => model.CreatedDate)</p>
            </div>
            <!-- /.box-body -->
        </div>
    </div>
</div>

<script type="text/javascript">
    $(function () {

    });
</script>