@model SalonCRM.Models.MemberViewModel
@{
    Layout = "~/Views/Shared/_WapLayout.cshtml";
    ViewBag.Title = "客户详细";
}

<div class="row">
    <div class="col-md-12">
        <div class="box">
            <div class="box-body">
                <div class="box-header with-border">
                    <h3 class="box-title">客户卡集</h3>
                </div>
                <div class="box-body">
                    <div class="table-responsive">
                        <table class="table no-margin">
                            <thead>
                                <tr>
                                    <th>项目名称</th>
                                    <th>单价</th>
                                    <th>总金额</th>
                                    <th>欠款</th>
                                    <th>购买次数</th>
                                    <th>已用次数</th>
                                    <th>剩余次数</th>
                                    <th>销售</th>
                                    <th>购买时间</th>
                                </tr>
                            </thead>
                            @foreach (var item in Model.UsableProjects)
                            {
                                <tr>
                                    <td>
                                        @(item.CardType == "0" ? "储值卡：" : "")
                                        @(item.CardType == "1" ? "疗程卡：" : "")
                                        @(item.CardType == "2" ? "单次卡：" : "")
                                        @(item.CardType == "3" ? "体验卡：" : "")
                                        @(item.CardType == "4" ? "综合限时卡：" : "")
                                        @(item.CardType == "5" ? "综合限次卡：" : "")
                                        @(item.CardType == "6" ? "拓客增值卡：" : "")
                                        @(item.CardType == "7" ? "拓客优惠卡：" : "")

                                        @( item.ProjectName + (item.Type == "1" ? "[赠]" : "") + (item.Type == "2" ? "[转]" : ""))
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.UnitPrice)
                                    </td>

                                    <td>
                                        @Html.DisplayFor(modelItem => item.Amount)
                                    </td>
                                    <td>
                                        <span style="color:firebrick;">@(item.Amount - item.ActualPrice)</span>
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.BookTime)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.UsedTime)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.LastCount)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.SalesStr)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.CreatedDate)
                                    </td>
                                </tr>
                            }
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(function () {

    });
</script>
