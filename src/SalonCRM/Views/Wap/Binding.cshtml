@using SalonCRM.Models;
@{
    ViewBag.Title = "微信_个人设置";
    Layout = null;
    var openId = (string)ViewData["OpenID"];
    var cur = (Member)Session["CurrentMember"];
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <script src="http://libs.useso.com/js/jquery/2.2.4/jquery.min.js"></script>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Scripts/bootstrap.min.js"></script>
</head>
<body id="sink">
    <div class="jumbotron">
        @if (cur != null)
        {
            <div class="alert alert-success" role="alert">当前微信已经绑定 @cur.Name</div>
        }

        @using (Html.BeginForm("Binding", "Wap", FormMethod.Post, new { id = "frm" }))
        {
            <div class="ui purple inverted top fixed menu">
                <div class="text item">个人设置</div>
                <div class="right menu">
                    <div class="item">
                        <button type="submit" class="ui submit button">保存</button>
                    </div>
                </div>
            </div>

            <div class="container">
                <input type="hidden" id="OpenID" name="OpenID" value='@openId' />
                <table class="ui very basic unstackable table">
                    <tbody>
                        <tr>
                            <td>卡号</td>
                            <td>@Html.TextBox("CardNo", "", new { @placeholder = "卡号" })</td>
                        </tr>
                        <tr>
                            <td>密码</td>
                            <td>@Html.TextBox("Passwd", "", new { @placeholder = "密码" })</td>
                        </tr>

                    </tbody>
                </table>
            </div>
        }
    </div>
</body>
</html>
