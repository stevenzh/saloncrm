@model SalonCRM.Models.BookModel
@{
    Layout = "~/Views/Shared/_WapLayout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title">消费详细</h3>
            </div>
            <!-- /.box-header -->
            <div class="box-body">
                <strong><i class="fa fa-book margin-r-5"></i> 订单号</strong>
                <p class="text-muted">@Html.DisplayFor(model => model.BookID)</p>
                <hr>
                <strong><i class="fa fa-map-marker margin-r-5"></i> 消费金额</strong>
                <p  class="text-muted">@Html.DisplayFor(model => model.Amount)</p>
                <hr>
                <strong><i class="fa fa-pencil margin-r-5"></i> 门店</strong>
                <p class="text-muted">@Html.DisplayFor(model => model.Branch.Name)</p>
                <hr>
                <strong><i class="fa fa-file-text-o margin-r-5"></i> No操作时间tes</strong>
                <p>@Html.DisplayFor(model => model.CreatedDate)</p>
            </div>
            <!-- /.box-body -->
        </div>
    </div>

    <div class="col-xs-12 table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>项目名称</th>
                    <th>数量</th>
                    <th>金额</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bb in Model.BookProjects)
                {
                    <tr>
                        <td>@bb.Project.Name</td>
                        <td>@bb.Quantity</td>
                        <td>@bb.Amount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <!-- /.col -->
</div>

<script type="text/javascript">
    $(function () {

    });
</script>